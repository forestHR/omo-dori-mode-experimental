{
  "backend": "herdr",
  "stateDir": "~/.dori/state",
  "laneWorkspace": "lanes",
  "workspaces": [
    "lanes"
  ],
  "ignorePanes": [],
  "leadPane": "<your herdr pane id, from: herdr pane current>",
  "defaultCwd": "~/code/my-project",
  "agentCommand": [
    "omo",
    "--model",
    "{model}",
    "{prompt}"
  ],
  "defaultModel": "anthropic/claude-opus-5-5",
  "launchKeywords": "ulw set goal and work",
  "sessionsDir": "~/.omo/agent/sessions",
  "nudgeAfterMin": 15,
  "postAfterMin": 20,
  "closeAfterMin": 5,
  "heavySlots": 1,
  "heavyMaxLoad": 80,
  "heavyMaxSlots": 8,
  "heavyHeadroomPct": 10,
  "heavySettleSec": 120,
  "deadPanePatterns": [
    "has stopped",
    "no suitable jobs"
  ],
  "reviewers": {
    "allowSameFamily": false
  },
  "guard": {
    "loadAlert": 150,
    "loadOk": 80,
    "memFreeMinPct": 20,
    "diskFreeMinGb": 50,
    "panesMax": 20
  },
  "supervision": {
    "defaults": { "wallMinutes": null, "tokens": null, "costUsd": null },
    "lanes": { "long-train": { "wallMinutes": 720, "costUsd": 50 } },
    "hungAfterMinutes": 20,
    "staleAfterMinutes": 20,
    "usageArgv": [],
    "recordCostArgv": [],
    "activityPaths": [],
    "gitActivity": true
  },
  "hooks": {
    "threadReply": [
      "my-messenger",
      "reply",
      "--thread",
      "{thread}",
      "--text",
      "{text}"
    ],
    "threadDone": [
      "my-messenger",
      "set-status",
      "--thread",
      "{thread}",
      "--status",
      "done",
      "--note",
      "{text}"
    ],
    "transcribe": [
      "my-stt",
      "--file",
      "{file}"
    ]
  }
}
