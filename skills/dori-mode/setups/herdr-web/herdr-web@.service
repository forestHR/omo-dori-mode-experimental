[Unit]
Description=herdr browser login proxy on port %i
Requires=herdr-web-terminal@%i.service
After=herdr-web-terminal@%i.service

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# optional: a Dori that moved from aoe keeps its aoe serve passphrase; a fresh install sets HERDR_WEB_PASSPHRASE below
EnvironmentFile=-%h/.config/agent-of-empires/serve.env
EnvironmentFile=%h/.config/herdr/web-%i.env
Environment=HERDR_WEB_PORT=%i
ExecStart=%h/.bun/bin/bun %h/.dori/src/skills/dori-mode/setups/herdr-web/proxy.ts
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
