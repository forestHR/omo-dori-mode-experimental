#!/usr/bin/env bash
# herdr with one refusal: "herdr server stop" from inside a herdr pane. Link it as ~/.local/bin/herdr (ahead of the real
# herdr on PATH), as tmux-guard is linked for tmux.
#
# A stopped herdr server ends every agent in its panes, the lead's included (measured on herdr 0.9.5). Every pane gets
# HERDR_SOCKET_PATH for the live server, so a lane's QA cleanup that runs "herdr server stop" in a pane, even with another
# XDG_CONFIG_HOME, would aim at the server every Dori session runs on (the tmux kill-server of 2026-10-22, again). Inside a
# pane (HERDR_PANE_ID set) the guard refuses it (HERDR_GUARD_REFUSED, exit 1) unless HERDR_GUARD_ALLOW=1 says the call is
# meant; a test server gets its own socket with HERDR_SOCKET_PATH and XDG_CONFIG_HOME both pointing elsewhere. Every other
# call goes to the first other herdr on PATH unchanged.
set -u
self=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
real=""
IFS=: read -ra dirs <<<"${PATH:-/usr/bin:/bin}"
for d in "${dirs[@]}"; do
  c="$d/herdr"
  [ -x "$c" ] && [ ! -d "$c" ] || continue
  [ "$(readlink -f "$c" 2>/dev/null || printf '%s' "$c")" = "$self" ] && continue
  real=$c
  break
done
[ -n "$real" ] || { echo "herdr-guard: no other herdr on PATH" >&2; exit 127; }

words=()
for a in "$@"; do case $a in -*) ;; *) words+=("$a") ;; esac; done
if [ -n "${HERDR_PANE_ID:-}" ] && [ "${HERDR_GUARD_ALLOW:-}" != 1 ] && [ "${words[0]:-}" = server ] && [ "${words[1]:-}" = stop ]; then
  # the socket this call would use: HERDR_SOCKET_PATH when set (every pane has it), else herdr's default under XDG_CONFIG_HOME
  want=${HERDR_SOCKET_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr/herdr.sock}
  echo "HERDR_GUARD_REFUSED: herdr server stop inside a herdr pane would end every agent on the server at $want, the lead's included; set HERDR_GUARD_ALLOW=1 for a server you started yourself" >&2
  exit 1
fi
exec "$real" "$@"
